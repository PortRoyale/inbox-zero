# Caddy in front of Readyline: automatic HTTPS (Let's Encrypt or ZeroSSL), TLS 1.3 only, and
# post-quantum hybrid key exchange (X25519MLKEM768) preferred, with X25519 as the fallback.
# Needs Caddy 2.10 or later (built with Go 1.24+). deploy/compose.yaml pins the image.
#
# APP_DOMAIN is the bare host name from APP_URL, for example app.example.com. Its DNS A/AAAA
# records must point at this server, with ports 80 and 443 open, before the first start.

{
	# Optional: an address for certificate expiry notices from the ACME CA.
	# email ops@example.com
}

{$APP_DOMAIN} {
	tls {
		protocols tls1.3
		curves x25519mlkem768 x25519
	}

	encode zstd gzip

	# Refuse oversized request bodies at the edge, before they reach the app. The app's largest
	# limit is the 6 MiB SBOM upload and it answers that with a clear message, so the edge limit sits
	# just above it.
	request_body {
		max_size 7MiB
	}

	# HSTS, CSP and the other security headers are set by the app. Do not add them here, or
	# browsers receive duplicates. Only drop the server banner.
	header -Server

	reverse_proxy app:3000 {
		# The app takes the client address from the last X-Forwarded-For entry
		# (TRUST_PROXY_HOPS=1). Overwrite whatever the client sent with the address Caddy sees,
		# so it cannot be spoofed to dodge rate limits or pollute the audit log.
		header_up X-Forwarded-For {client_ip}
	}
}
