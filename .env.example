# Readyline configuration. Copy to .env.production for a deployment (see README, "Run in production")
# or to .env.local for development, where every value below is optional.
#
# Secrets: run `pnpm keys:generate --out .env.production` first. It writes the five READYLINE_* keys,
# IP_HASH_SALT and CRON_SECRET to a new file with mode 0600. Then append the settings below.

# ---------- Site ----------
# The public https URL of the deployment. Used for links in emails, cookies (__Host- prefix and
# Secure when https), CSRF origin checks, canonical links and the sitemap.
APP_URL=https://app.example.com
# The same URL for the browser bundle. Read at build time.
NEXT_PUBLIC_SITE_URL=https://app.example.com
# Bare host name for Caddy (deploy/Caddyfile). Must match APP_URL.
APP_DOMAIN=app.example.com

# ---------- Keys and secrets (from `pnpm keys:generate`) ----------
# 32-byte master key and pepper, base64. Losing either is unrecoverable; back them up offline.
READYLINE_MASTER_KEY=
READYLINE_PEPPER=
# PKCS#8 DER, base64: ML-KEM-1024 (encryption at rest), Ed25519 and ML-DSA-65 (signatures).
READYLINE_KEM_PRIVATE=
READYLINE_SIGN_ED25519_PRIVATE=
READYLINE_SIGN_MLDSA_PRIVATE=
# Keyed hash for IP addresses in the audit log and rate limits. Required in production (32+ chars).
IP_HASH_SALT=
# Bearer token for /api/cron/sbom-watch/ and /api/cron/billing/ (32+ chars). Cron is off without it.
CRON_SECRET=

# ---------- Email (one is required in production) ----------
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
MAIL_FROM=Readyline <no-reply@example.com>

# ---------- People ----------
# Comma-separated emails that can open /admin/ (early-access requests, every team, manual plans).
SUPERADMIN_EMAILS=
# Session lifetime in days (1 to 90).
SESSION_DAYS=30

# ---------- Billing ----------
# finix, stripe or none. With none, teams keep the 14-day trial and a superadmin grants plans by hand.
BILLING_PROVIDER=none

# Finix: yearly prepay through a Finix hosted checkout form.
# Sandbox: https://finix.sandbox-payments-api.com  Live: https://finix.live-payments-api.com
FINIX_API_URL=https://finix.sandbox-payments-api.com
FINIX_USERNAME=
FINIX_PASSWORD=
FINIX_MERCHANT_ID=
# The webhook's secret signing key (Finix-Signature header check). Required.
FINIX_WEBHOOK_SIGNING_KEY=
# Optional extra check: the bearer token you set on the webhook's authentication in Finix.
FINIX_WEBHOOK_BEARER=
# Currency your Finix merchant settles in, and yearly prices in minor units (178800 = 1,788.00).
FINIX_CURRENCY=USD
FINIX_PRICE_STARTER_YEAR=178800
FINIX_PRICE_TEAM_YEAR=598800
# Terms link shown on the Finix checkout page. Defaults to APP_URL/terms/.
TERMS_URL=

# Stripe: monthly subscriptions through Stripe Checkout, managed in the Stripe customer portal.
STRIPE_API_URL=https://api.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) of the recurring Starter and Team prices.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
# 1 to let Stripe Tax calculate VAT (needs Stripe Tax set up in your account).
STRIPE_AUTOMATIC_TAX=0

# ---------- Runtime ----------
# Where readyline.db lives. The Docker image uses /data (a volume).
DATA_DIR=/data
# Reverse proxies in front of the app; the client address is read that many entries from the end
# of X-Forwarded-For. 1 for the supplied Caddy setup; 0 ignores the header.
TRUST_PROXY_HOPS=1
# OSV vulnerability database. Change only to point at a mirror.
OSV_API_URL=https://api.osv.dev

# Development only: run a production build over plain http on localhost. Never set in production.
# READYLINE_ALLOW_INSECURE=1
